#!/usr/bin/env python3
"""Offline stand-in for the `devbox` CLI.

The detection test needs the script to read a throwaway "global" directory
instead of the real one, and to see a package list that matches the throwaway
devbox.json. Both come from the environment:

    $UPDATE_FLAKE_TEST_ROOT   the directory the script must treat as the
                              devbox global directory
    $UPDATE_FLAKE_ENABLED     a file with one enabled flake name per line
"""

import os
import sys


def main():
    args = sys.argv[1:]
    if args[:2] == ["global", "path"]:
        print(os.environ.get("UPDATE_FLAKE_TEST_ROOT", ""))
        return 0

    if args[:2] == ["global", "list"]:
        root = os.environ.get("UPDATE_FLAKE_TEST_ROOT", "")
        enabled = os.environ.get("UPDATE_FLAKE_ENABLED", "")
        if enabled and os.path.exists(enabled):
            with open(enabled) as handle:
                for line in handle:
                    name = line.strip()
                    if name:
                        print(f"* path:devbox.d/{name}")
        return 0

    sys.stderr.write(f"fake devbox: unsupported command {' '.join(args)}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
