{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "{{ .chezmoi.homeDir }}/.config/bifrost/logs.db"
    },
    "retention_days": 7
  },
  "vector_store": {
    "enabled": true,
    "type": "redis",
    "config": {
      "addr": "localhost:6379"
    }
  },
  "load_balancer_config": {
    "append_fallbacks_to_pinned": true,
    "prune_failed_fallbacks": true
  },
  "client": {
    "compat": {
      "should_drop_params": true,
      "should_convert_params": true
    },
    "log_retention_days": 7
  },
  "circuit_breaker_config": {
    "policies": [
      {
        "provider": "zai",
        "model": "glm-5.3",
        "fallback_provider": "alibaba-token-plan",
        "fallback_model": "glm-5.2"
      },
      {
        "provider": "zai",
        "model": "glm-5.2",
        "fallback_provider": "alibaba-token-plan",
        "fallback_model": "glm-5.2"
      },
      {
        "provider": "kimi-for-coding",
        "model": "k3",
        "fallback_provider": "opencode-go",
        "fallback_model": "kimi-k3"
      },
      {
        "provider": "minimax",
        "model": "MiniMax-M3",
        "fallback_provider": "opencode-go",
        "fallback_model": "minimax-m3"
      },
      {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "fallback_provider": "opencode-go",
        "fallback_model": "deepseek-v4-pro"
      },
      {
        "provider": "opencode-go",
        "model": "deepseek-v4-flash",
        "fallback_provider": "deepseek",
        "fallback_model": "deepseek-v4-flash"
      }
    ]
  },
  "providers": {
    "zai": {
      "custom_provider_config": {
        "base_provider_type": "openai",
        "request_path_overrides": {
          "chat_completion": "https://api.z.ai/api/coding/paas/v4/chat/completions",
          "chat_completion_stream": "https://api.z.ai/api/coding/paas/v4/chat/completions"
        }
      },
      "network_config": {
        "base_url": "https://api.z.ai/api/coding/paas/v4",
        "extra_headers": {
          "Accept-Language": "en-US,en"
        },
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "keys": [
        {
          "name": "zai-key",
          "value": "env.ZAI_API_KEY",
          "models": [
            "glm-5.3",
            "glm-5.3-flash",
            "glm-5.2",
            "glm-4.7"
          ],
          "weight": 1
        }
      ]
    },
    "moonshotai": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "https://api.moonshot.ai",
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "keys": [
        {
          "name": "moonshot-key",
          "value": "env.MOONSHOT_API_KEY",
          "models": [
            "kimi-k3",
            "kimi-k2.7-code",
            "kimi-k2.7-code-highspeed"
          ],
          "weight": 1
        }
      ]
    },
    "kimi-for-coding": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "https://api.kimi.com/coding",
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "keys": [
        {
          "name": "kimi-for-coding-key",
          "value": "env.KIMI_API_KEY",
          "models": [
            "k3",
            "k3-256k",
            "kimi-for-coding",
            "kimi-for-coding-highspeed"
          ],
          "weight": 1
        }
      ]
    },
    "minimax": {
      "custom_provider_config": {
        "base_provider_type": "openai",
        "sends_done_marker": false
      },
      "network_config": {
        "base_url": "https://api.minimax.io",
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000,
        "stream_idle_timeout_in_seconds": 60
      },
      "keys": [
        {
          "name": "minimax-key",
          "value": "env.MINIMAX_API_KEY",
          "models": [
            "MiniMax-M3"
          ],
          "weight": 1
        }
      ]
    },
    "openrouter": {
      "network_config": {
        "base_url": "https://openrouter.ai/api",
        "max_retries": 3
      },
      "keys": [
        {
          "name": "openrouter-key",
          "value": "env.OPENROUTER_API_KEY",
          "models": [
            "z-ai/glm-5.2",
            "moonshotai/kimi-k3",
            "minimax/minimax-m3",
            "deepseek/deepseek-v4-pro-0813",
            "deepseek/deepseek-v4-flash",
            "deepseek/deepseek-v4-flash-0731",
            "deepseek/deepseek-v4.1-flash",
            "xiaomi/mimo-v2.5",
            "xiaomi/mimo-v2.5-pro",
            "moonshotai/kimi-k2.7-code",
            "deepseek/deepseek-v4-flash-vision-exp",
            "z-ai/glm-5.3-flash",
            "z-ai/glm-5.3",
            "moonshotai/kimi-k2.6",
            "minimax/minimax-m2.7",
            "minimax/minimax-m2.5",
            "deepseek/deepseek-v4-pro",
            "qwen/qwen3.8-max",
            "qwen/qwen3.8-flash",
            "qwen/qwen3.7-max",
            "qwen/qwen3.7-plus",
            "meituan/longcat-2.0",
            "tencent/hy3",
            "tencent/hy4-preview"
          ],
          "weight": 1
        }
      ]
    },
    "opencode-go": {
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "keys": [
        {
          "name": "go-key",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ]
    },
    "deepseek": {
      "network_config": {
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "keys": [
        {
          "name": "deepseek-key",
          "value": "env.DEEPSEEK_API_KEY",
          "models": [
            "deepseek-flash",
            "deepseek-v4-pro",
            "deepseek-v4-flash",
            "deepseek-v4-flash-vision-exp"
          ],
          "weight": 1
        }
      ]
    },
    "alibaba-token-plan": {
      "custom_provider_config": {
        "is_key_less": false,
        "base_provider_type": "anthropic"
      },
      "network_config": {
        "base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic",
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000,
        "stream_idle_timeout_in_seconds": 600
      },
      "keys": [
        {
          "name": "alibaba-token-plan-key",
          "value": "env.ALIBABA_TOKEN_PLAN_API_KEY",
          "models": [
            "deepseek-v4-flash-0731",
            "deepseek-v4-pro",
            "deepseek-v4.1-flash",
            "glm-5.2",
            "qwen3.6-flash",
            "qwen3.7-max",
            "qwen3.7-plus",
            "qwen3.8-flash",
            "qwen3.8-max"
          ],
          "weight": 1
        }
      ]
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "glm-5.3-failover-chain",
        "name": "GLM-5.3 failover chain",
        "description": "GLM-5.3: zai Max primary -> opencode-go/glm-5.3 (Go $15) -> openrouter",
        "cel_expression": "model == 'glm-5.3'",
        "targets": [
          {
            "provider": "zai",
            "model": "glm-5.3",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/glm-5.3",
          "openrouter/z-ai/glm-5.3"
        ],
        "priority": 6,
        "enabled": true
      },
      {
        "id": "glm-5.2-failover-chain",
        "name": "GLM-5.2 failover chain",
        "description": "GLM-5.2: zai primary -> opencode-go -> openrouter",
        "cel_expression": "model == 'glm-5.2'",
        "targets": [
          {
            "provider": "zai",
            "model": "glm-5.2",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/glm-5.2",
          "openrouter/z-ai/glm-5.2"
        ],
        "priority": 1,
        "enabled": true
      },
      {
        "id": "kimi-k3-failover-chain",
        "name": "Kimi K3 failover chain",
        "description": "Kimi K3: kimi-for-coding primary → opencode-go/kimi-k3 (Go $15) → openrouter",
        "cel_expression": "model == 'kimi-k3' || model == 'k3'",
        "targets": [
          {
            "provider": "kimi-for-coding",
            "model": "k3",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/kimi-k3",
          "openrouter/moonshotai/kimi-k3"
        ],
        "priority": 2,
        "enabled": true
      },
      {
        "id": "minimax-m3-failover-chain",
        "name": "MiniMax-M3 failover chain",
        "description": "MiniMax-M3: minimax primary → opencode-go → openrouter",
        "cel_expression": "model == 'MiniMax-M3'",
        "targets": [
          {
            "provider": "minimax",
            "model": "MiniMax-M3",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/minimax-m3",
          "openrouter/minimax/minimax-m3"
        ],
        "priority": 3,
        "enabled": true
      },
      {
        "id": "deepseek-v4-pro-failover-chain",
        "name": "DeepSeek V4 Pro failover chain",
        "description": "DeepSeek V4 Pro: deepseek primary → opencode-go → openrouter",
        "cel_expression": "model == 'deepseek-v4-pro'",
        "targets": [
          {
            "provider": "deepseek",
            "model": "deepseek-v4-pro",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/deepseek-v4-pro",
          "openrouter/deepseek/deepseek-v4-pro-0813"
        ],
        "priority": 4,
        "enabled": true
      },
      {
        "id": "deepseek-v4-flash-failover-chain",
        "name": "DeepSeek V4 Flash failover chain",
        "description": "DeepSeek V4 Flash 0731: opencode-go primary → deepseek → openrouter",
        "cel_expression": "model == 'deepseek-v4-flash'",
        "targets": [
          {
            "provider": "opencode-go",
            "model": "deepseek-v4-flash",
            "weight": 1
          }
        ],
        "fallbacks": [
          "deepseek/deepseek-v4-flash",
          "openrouter/deepseek/deepseek-v4-flash-0731"
        ],
        "priority": 5,
        "enabled": true
      },
      {
        "id": "deepseek-v4-flash-vision-failover-chain",
        "name": "DeepSeek V4 Flash Vision failover chain",
        "description": "DeepSeek V4 Flash Vision (exp, multimodal): deepseek primary → openrouter (OR endpoint currently blocked by account guardrail)",
        "cel_expression": "model == 'deepseek-v4-flash-vision-exp'",
        "targets": [
          {
            "provider": "deepseek",
            "model": "deepseek-v4-flash-vision-exp",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/deepseek-v4-flash-vision-exp",
          "openrouter/deepseek/deepseek-v4-flash-vision-exp"
        ],
        "priority": 7,
        "enabled": true
      },
      {
        "id": "glm-5.3-flash-failover-chain",
        "name": "GLM-5.3-Flash failover chain",
        "description": "GLM-5.3-Flash (Aug 26, MIT): zai coding-plan primary (3x quota vs 5.3, off-peak 50%) → opencode-go (Go $15 usage) → deepseek vision-exp (multimodal-capable, different family)",
        "cel_expression": "model == 'glm-5.3-flash'",
        "targets": [
          {
            "provider": "zai",
            "model": "glm-5.3-flash",
            "weight": 1
          }
        ],
        "fallbacks": [
          "opencode-go/glm-5.3-flash",
          "deepseek/deepseek-v4-flash-vision-exp"
        ],
        "priority": 9,
        "enabled": true
      },
      {
        "id": "qwen3.8-flash-failover-chain",
        "name": "Qwen3.8 Flash failover chain",
        "description": "Qwen3.8 Flash (multimodal): opencode-go primary (Go $30) -> openrouter",
        "cel_expression": "model == 'qwen3.8-flash'",
        "targets": [
          {
            "provider": "opencode-go",
            "model": "qwen3.8-flash",
            "weight": 1
          }
        ],
        "fallbacks": [
          "openrouter/qwen/qwen3.8-flash"
        ],
        "priority": 11,
        "enabled": true
      },
      {
        "id": "deepseek-v4.1-flash-failover-chain",
        "name": "DeepSeek V4.1 Flash failover chain",
        "description": "DeepSeek V4.1 Flash (Sep 10, MIT, multimodal): opencode-go/deepseek-v4.1-flash primary → deepseek/deepseek-flash → openrouter",
        "cel_expression": "model == 'deepseek-flash' || model == 'deepseek-v4.1-flash'",
        "targets": [
          {
            "provider": "opencode-go",
            "model": "deepseek-v4.1-flash",
            "weight": 1
          }
        ],
        "fallbacks": [
          "deepseek/deepseek-flash",
          "openrouter/deepseek/deepseek-v4.1-flash"
        ],
        "priority": 12,
        "enabled": true
      }
    ]
  },
  "plugins": [
    {
      "name": "semantic_cache",
      "enabled": true,
      "config": {
        "mode": "direct",
        "dimension": 1,
        "ttl_seconds": 3600,
        "default_cache_key": "auto"
      }
    }
  ]
}
