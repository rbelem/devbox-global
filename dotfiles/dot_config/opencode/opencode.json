{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "small_model": "opencode-go/mimo-v2.5",
  "provider": {
    "bifrost": {
      "name": "Bifrost (local gateway)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8081/v1",
        "apiKey": "bifrost-local"
      },
      "models": {
        "zai/glm-5.2": {
          "name": "GLM-5.2 (z.ai direct)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 (Moonshot direct)",
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "minimax/MiniMax-M3": {
          "name": "MiniMax-M3 (MiniMax direct)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "opencode-go/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (OpenCode Go)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (DeepSeek direct)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (DeepSeek direct)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "opencode-go/mimo-v2.5": {
          "name": "Mimo v2.5 (OpenCode Go)",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "opencode-go/mimo-v2.5-pro": {
          "name": "Mimo v2.5 Pro (OpenCode Go)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "opencode-go/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (OpenCode Go)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 131072
          }
        },
        "zai/glm-4.7": {
          "name": "GLM-4.7 (z.ai Coding Pro subscription, 1x quota - preferred for routine)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 131072
          }
        },
        "moonshotai/kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code Highspeed (Moonshot direct, speed-optimized coding)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 131072
          }
        },
        "opencode-go/qwen3.7-max": {
          "name": "Qwen 3.7 Max (Go free tier, reasoning specialist)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "opencode-go/qwen3.8-max": {
          "name": "Qwen 3.8 Max (OpenCode Go)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "opencode-go/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus (OpenCode Go)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true,
    "mcp_timeout": 60000
  },
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false,
    "cors": []
  },
  "subagent_depth": 2,
  "watcher": {
    "ignore": ["node_modules", "dist", ".codegraph", ".next", "target"]
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["bunx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": true
    },
    "firefox-devtools": {
      "type": "local",
      "command": ["bunx", "-y", "@mozilla/firefox-devtools-mcp@latest"],
      "enabled": true
    },
    "tmux": {
      "type": "local",
      "command": ["uvx", "libtmux-mcp"],
      "environment": {
        "LIBTMUX_SAFETY": "read+send"
      }
    },
    "opencode-docs": {
      "type": "local",
      "command": ["bunx", "-y", "opencode-docs-mcp@latest"],
      "enabled": true
    },
    "agentmemory": {
      "type": "local",
      "command": ["agentmemory", "mcp"],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "timeout": 600000,
      "enabled": true
    },
    "wigolo": {
      "type": "remote",
      "url": "http://127.0.0.1:3333/mcp",
      "enabled": true
    }
  },
  "tools": {
    "firecrawl-mcp_firecrawl_monitor_*": false,
    "firecrawl-mcp_firecrawl_research_*": false,
    "firecrawl-mcp_firecrawl_agent*": false,
    "chrome-devtools_performance_*": false,
    "chrome-devtools_lighthouse_*": false,
    "chrome-devtools_take_heapsnapshot": false
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.agents/*": "allow",
      "~/.config/opencode/skills/*": "allow",
      "~/.local/share/devbox/global/default": "allow",
      "~/Workspace/rbelem/*": "allow",
      "~/Workspace/github.com/rbelem/*": "allow",
      "/tmp/*": "allow"
    },
    "lsp": "allow",
    "question": "allow",
    "skill": {
      "*": "allow"
    },
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "read": {
      "~/.config/opencode/get-shit-done/*": "allow"
    },
    "doom_loop": "deny"
  },
  "plugin": [
    "@slkiser/opencode-quota",
    "@ramarivera/opencode-model-announcer",
    "@tarquinen/opencode-smart-title",
    "./plugins/agentmemory-capture.ts",
    "./plugins/autolearn.js",
    "./plugins/dcg-guard.ts",
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "autolearn-reviewer": {
      "description": "Reviews past conversations for self-improvement opportunities",
      "hidden": true,
      "steps": 20,
      "prompt": "Load the autolearn-reviewer skill and follow its instructions to review the attached conversation for learning opportunities. Take immediate action: record observations, update memory, create or patch skills.",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "edit": "deny",
        "webfetch": "deny",
        "task": "deny",
        "skill": "allow",
        "external_directory": "allow"
      }
    }
  },
  "compaction": {
    "prune": true,
    "tail_turns": 10
  },
  "tool_output": {
    "max_lines": 400
  },
  "formatter": true,
  "lsp": true,
  "instructions": [
    "/home/rodrigo/.autolearn/personas/default/memory.context.md"
  ]
}
