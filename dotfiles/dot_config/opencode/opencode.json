{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "providers": {
    "bifrost": {
      "name": "Bifrost (local gateway)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8081/v1",
        "apiKey": "bifrost-local"
      },
      "models": {
        "zai/glm-5.3": {
          "name": "GLM-5.3 (z.ai direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "zai/glm-5.2": {
          "name": "GLM-5.2 (z.ai direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "kimi-for-coding/k3": {
          "name": "Kimi K3 (Kimi for Coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1048576, "output": 131072 }
        },
        "kimi-for-coding/k3-256k": {
          "name": "Kimi K3 256k (Kimi for Coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 }
        },
        "kimi-for-coding/kimi-for-coding": {
          "name": "Kimi K2.7 Coding (Kimi for Coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 }
        },
        "kimi-for-coding/kimi-for-coding-highspeed": {
          "name": "Kimi K2.7 Coding Highspeed (Kimi for Coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 (Moonshot direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "minimax/MiniMax-M3": {
          "name": "MiniMax-M3 (MiniMax direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (DeepSeek direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (DeepSeek direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "opencode-go/mimo-v2.5": {
          "name": "Mimo v2.5 (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 16384 }
        },
        "opencode-go/mimo-v2.5-pro": {
          "name": "Mimo v2.5 Pro (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 16384 }
        },
        "opencode-go/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 }
        },
        "zai/glm-4.7": {
          "name": "GLM-4.7 (z.ai Coding Pro subscription, 1x quota - preferred for routine)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 }
        },
        "moonshotai/kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code Highspeed (Moonshot direct, speed-optimized coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 }
        },
        "opencode-go/qwen3.7-max": {
          "name": "Qwen 3.7 Max (Go free tier, reasoning specialist)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 16384 }
        },
        "opencode-go/qwen3.8-max": {
          "name": "Qwen 3.8 Max (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 16384 }
        },
        "opencode-go/qwen3.7-plus": {
          "name": "Qwen 3.7 Plus (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    },
    "copilot": {},
    "openai": {},
    "openrouter": {},
    "zai": {},
    "zhipu": {},
    "minimax-coding-plan": {},
    "deepseek": {},
    "opencode-go": {}
  },
  "experimental": {
    "disable_paste_summary": true,
    "subagent_depth": 2
  },
  "watcher": {
    "ignore": [
      "node_modules",
      "dist",
      ".codegraph",
      ".next",
      "target"
    ]
  },
  "mcp": {
    "timeout": {
      "catalog": 60000,
      "execution": 60000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ]
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--connectExisting",
          "--marionettePort",
          "2828"
        ]
      },
      "opencode-docs": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "opencode-docs-mcp@latest"
        ]
      },
      "agentmemory": {
        "type": "local",
        "command": [
          "agentmemory",
          "mcp"
        ]
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "timeout": {
          "catalog": 600000,
          "execution": 600000
        }
      },
      "wigolo": {
        "type": "remote",
        "url": "http://127.0.0.1:3333/mcp"
      },
      "bifrost": {
        "type": "remote",
        "url": "http://127.0.0.1:8081/mcp"
      }
    }
  },
  // V2 one-rule-per-line permission syntax, disabled for now as in the V1 config.
  // Note: `lsp` and `doom_loop` have no V2 permission action equivalent.
  //"permissions": [
  //  { "action": "external_directory", "resource": "*", "effect": "ask" },
  //  { "action": "external_directory", "resource": "~/.agents/*", "effect": "allow" },
  //  { "action": "external_directory", "resource": "~/.cargo/*", "effect": "allow" },
  //  { "action": "external_directory", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
  //  { "action": "external_directory", "resource": "~/.local/share/devbox/*", "effect": "allow" },
  //  { "action": "external_directory", "resource": "~/Workspace/rbelem/*", "effect": "allow" },
  //  { "action": "external_directory", "resource": "~/Workspace/github.com/*", "effect": "allow" },
  //  { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
  //  { "action": "question", "resource": "*", "effect": "allow" },
  //  { "action": "skill", "resource": "*", "effect": "allow" },
  //  { "action": "webfetch", "resource": "*", "effect": "deny" },
  //  { "action": "websearch", "resource": "*", "effect": "deny" },
  //  { "action": "read", "resource": "/nix/*", "effect": "allow" },
  //  { "action": "read", "resource": "~/.config/opencode/get-shit-done/*", "effect": "allow" },
  //  { "action": "todowrite", "resource": "*", "effect": "allow" },
  //  { "action": "firecrawl-mcp_firecrawl_monitor_*", "resource": "*", "effect": "deny" },
  //  { "action": "firecrawl-mcp_firecrawl_research_*", "resource": "*", "effect": "deny" },
  //  { "action": "firecrawl-mcp_firecrawl_agent*", "resource": "*", "effect": "deny" },
  //  { "action": "chrome-devtools_performance_*", "resource": "*", "effect": "deny" },
  //  { "action": "chrome-devtools_lighthouse_*", "resource": "*", "effect": "deny" },
  //  { "action": "chrome-devtools_take_heapsnapshot", "resource": "*", "effect": "deny" }
  //],
  "plugins": [
    "oh-my-opencode-slim@latest",
    "@prevalentware/opencode-goal-plugin"
    // ponytail: local V2 port at plugins/ponytail
    // model-announcer / dcg-guard / agentmemory-capture / autolearn: local V2
    //   ports, direct files in plugins/ (auto-discovered)
    // deferred (no V2 support upstream): @slkiser/opencode-quota (TUI-heavy),
    //   @tarquinen/opencode-smart-title (superseded by native title agent)
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "title": {
      "model": "opencode-go/mimo-v2.5"
    },
    "autolearn-reviewer": {
      "description": "Reviews past conversations for self-improvement opportunities",
      "hidden": true,
      "steps": 20,
      "system": "Load the autolearn-reviewer skill and follow its instructions to review the attached conversation for learning opportunities. Take immediate action: record observations, update memory, create or patch skills.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        // V1 had write:allow + edit:deny; V2 merges write/patch/edit into one
        // `edit` action, so this grants full edit (incl. file creation).
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        //{ "action": "webfetch", "resource": "*", "effect": "deny" },
        //{ "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "tool_output": {
    "max_lines": 400
  },
  "formatter": true,
  "lsp": true,
  "instructions": [
    "/home/rodrigo/.autolearn/personas/default/memory.context.md",
    "/home/rodrigob/.autolearn/personas/default/memory.context.md"
  ]
}
