{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "providers": {
    "bifrost": {
      "name": "Bifrost (local gateway)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8081/v1",
        "apiKey": "bifrost-local"
      },
      "models": {
        "zai/glm-5.3": {
          "name": "GLM-5.3 (z.ai direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 131072 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "kimi-for-coding/k3": {
          "name": "Kimi K3 (Kimi for Coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1048576, "output": 131072 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "kimi-for-coding/k3-256k": {
          "name": "Kimi K3 256k (Kimi for Coding)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 131072 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "minimax/MiniMax-M3": {
          "name": "MiniMax-M3 (MiniMax direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 131072 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "opencode-go/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 384000 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (DeepSeek direct)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 1000000, "output": 384000 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "opencode-go/mimo-v2.5": {
          "name": "Mimo v2.5 (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 16384 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        },
        "opencode-go/qwen3.8-max": {
          "name": "Qwen 3.8 Max (OpenCode Go)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text", "reasoning"] },
          "limit": { "context": 262144, "output": 16384 },
          "variants": [
            { "id": "low", "body": { "reasoning_effort": "low" } },
            { "id": "medium", "body": { "reasoning_effort": "medium" } },
            { "id": "xhigh", "body": { "reasoning_effort": "high" } },
            { "id": "max", "body": { "reasoning_effort": "max" } }
          ]
        }
      }
    },
    "copilot": {},
    "openai": {},
    "openrouter": {},
    "zai": {},
    "zhipu": {},
    "minimax-coding-plan": {},
    "deepseek": {},
    "opencode-go": {}
  },
  "experimental": {
    "disable_paste_summary": true,
    "portable_shell_scanner": true,
    "subagent_depth": 2
  },
  "watcher": {
    "ignore": [
      "node_modules",
      "dist",
      ".codegraph",
      ".next",
      "target"
    ]
  },
  "mcp": {
    "timeout": {
      "catalog": 60000,
      "execution": 60000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ]
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--connectExisting",
          "--marionettePort",
          "2828"
        ]
      },
      "opencode-docs": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "opencode-docs-mcp@latest"
        ]
      },
      "agentmemory": {
        "type": "local",
        "command": [
          "agentmemory",
          "mcp"
        ]
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "timeout": {
          "catalog": 600000,
          "execution": 600000
        }
      },
      "wigolo": {
        "type": "remote",
        "url": "http://127.0.0.1:3333/mcp"
      },
      "bifrost": {
        "type": "remote",
        "url": "http://127.0.0.1:8081/mcp"
      }
    }
  },
  "permissions": [
    { "resource": "*", "effect": "ask", "action": "*" },
    { "resource": "*", "effect": "allow", "action": "glob" },
    { "resource": "*", "effect": "allow", "action": "grep" },
    { "resource": "*", "effect": "allow", "action": "list" },
    { "resource": "*", "effect": "allow", "action": "question" },
    { "resource": "*", "effect": "allow", "action": "read" },
    { "resource": "*", "effect": "allow", "action": "skill" },
    { "resource": "*", "effect": "allow", "action": "todowrite" },
    { "resource": "*", "effect": "allow", "action": "webfetch" },
    { "resource": "*", "effect": "allow", "action": "websearch" },

    { "resource": "git log *", "effect": "allow", "action": "shell" },
    { "resource": "git commit *", "effect": "allow", "action": "shell" },

    { "resource": "~/.agents/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.agents/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.cache/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.cargo/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.config/bifrost/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.config/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.config/nvim/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.local/share/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.local/share/*", "effect": "allow", "action": "external_directory" },
    { "resource": "/nix/*", "effect": "allow", "action": "external_directory" },
    { "resource": "/tmp/*", "effect": "allow", "action": "edit" },
    { "resource": "/tmp/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/Workspace/github.com/*", "effect": "allow", "action": "edit" },
    { "resource": "~/Workspace/github.com/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/Workspace/rbelem/*", "effect": "allow", "action": "edit" },
    { "resource": "~/Workspace/rbelem/*", "effect": "allow", "action": "external_directory" },
  ],
  "plugins": [
    "oh-my-opencode-slim@latest",
    "@prevalentware/opencode-goal-plugin"
    // ponytail: local V2 port at plugins/ponytail
    // model-announcer / dcg-guard / agentmemory-capture / autolearn: local V2
    //   ports, direct files in plugins/ (auto-discovered)
    // deferred (no V2 support upstream): @slkiser/opencode-quota (TUI-heavy),
    //   @tarquinen/opencode-smart-title (superseded by native title agent)
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "title": {
      "model": "opencode-go/mimo-v2.5"
    },
    "autolearn-reviewer": {
      "description": "Reviews past conversations for self-improvement opportunities",
      "hidden": true,
      "steps": 20,
      "system": "Load the autolearn-reviewer skill and follow its instructions to review the attached conversation for learning opportunities. Take immediate action: record observations, update memory, create or patch skills.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        // V1 had write:allow + edit:deny; V2 merges write/patch/edit into one
        // `edit` action, so this grants full edit (incl. file creation).
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        //{ "action": "webfetch", "resource": "*", "effect": "deny" },
        //{ "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "tool_output": {
    "max_lines": 400
  },
  "formatter": true,
  "lsp": true,
  "instructions": [
    "/home/rodrigo/.autolearn/personas/default/memory.context.md",
    "/home/rodrigob/.autolearn/personas/default/memory.context.md"
  ]
}
