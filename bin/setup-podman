#!/usr/bin/env bash
set -euo pipefail

# Registry policy for the rootless podman (strix runtime backend, and the Cua
# daemon pulling the Spaces images).
mkdir -p "$HOME/.config/containers"
cat <<EOF > "$HOME/.config/containers/policy.json"
{
  "default": [{"type": "insecureAcceptAnything"}],
  "transports": {"docker-daemon": {"": [{"type": "insecureAcceptAnything"}]}}
}
EOF

# The podman API socket itself is NOT installed here: the devbox global
# "podman" service owns it (process-compose.yml). Two podman API services on
# one socket path fight - the second takes the path over and the first stops
# answering it - so exactly one of them may own it.
#
# The nix podman ships its own systemd user units under $out/lib/systemd/user
# (podman.socket, podman.service). Link them into ~/.config/systemd/user
# instead of this script if you want the socket socket-activated at boot
# rather than owned by the devbox service.
