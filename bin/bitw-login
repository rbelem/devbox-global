#!/usr/bin/env bash
# bitw-login
# Manual Bitwarden OAuth login via BW Personal API Keys (client_credentials grant).
#
# bitw is the rbelem/bitw fork — a CLI client for Bitwarden (NOT a D-Bus Secret
# Service provider; that direction was rejected per ADR-0004:123-125 and the
# dbus.go path will be deleted in Phase 7). It reads BW_CLIENTID and
# BW_CLIENTSECRET env vars at startup (crypto.go:111,127) and uses the
# client_credentials OAuth grant (auth.go) for machine-to-machine auth.
# This bypasses the captcha gate that broke the password grant flow.
#
# As of Phase 3a, client_credentials users no longer need to configure
# $EMAIL (or have a synced profile email) — the email check + preLogin
# fetch are skipped when BW_CLIENTID is set (auth.go:84).
#
# ── One-time setup ──
# Generate a BW Personal API Key:
#   1. Log in to vault.bitwarden.com
#   2. Settings → Security → Keys → API Key
#   3. Master password confirmation
#   4. Copy the two values:
#        client_id:     user.<uuid>  (format: user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
#        client_secret: one-time-shown string (save it — not shown again)
#
# Recommended: also stash BW_CLIENTSECRET as a vault item named
# `devbox-global/bitwarden-api-key` (Login type, .login.password = client_secret,
# custom field BW_CLIENTID = user.<uuid>) per ADR-0003, so new machines
# self-heal on first `devbox global run secrets-refresh`.
#
# ── Usage ──
#   export BW_CLIENTID='user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
#   export BW_CLIENTSECRET='your-client-secret'
#   devbox global run bitw-login
#
# ── What this does ──
# Calls `bitw login`, which goes straight to client_credentials using
# the env vars above (no password grant, no captcha gate, no $EMAIL needed).
# The access_token lands in `~/.cache/bitw/data.json`
# (fork writes data.json at crypto.go / main.go; read by `bitw sync`, `bitw get`,
# `bitw create` etc.). Mirror to libsecret happens in the next
# `devbox global run secrets-refresh` (per ADR-0003).
#
# ── Status check (after Phase 7a) ──
#   devbox global run bitw status   # prints token source, expiry, LastSync
#
# ── References ──
# ADR-0003 — Bitwarden Personal API Key dual-storage pattern
# ADR-0004 — bw → bitw CLI parity migration
# ADR-0005 — Phase 7 token-broker architecture (forthcoming)
#
# ── Removed (were stale, do NOT add back) ──
#   bitw unlock    — does NOT exist as a bitw command (the master password
#                    lives in libsecret and is read internally by bitw via
#                    readLibsecretPassword() at crypto.go:98-105; you only
#                    need to unlock the libsecret keyring itself, which your
#                    DE handles at login).
#   bitw serve     — was the D-Bus Secret Service path, deleted in Phase 7
#                    (D-Bus name conflict with kwalletd5; not exposed to
#                    third-party clients).
set -euo pipefail

# ── Colors ──
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'

# ── Preflight checks ──
if ! command -v bitw >/dev/null 2>&1; then
  echo "${RED}ERROR:${NC} bitw not found. Run: devbox global install" >&2
  exit 1
fi

if [ -z "${BW_CLIENTID:-}" ] || [ -z "${BW_CLIENTSECRET:-}" ]; then
  echo "${RED}ERROR:${NC} BW_CLIENTID and BW_CLIENTSECRET must be set." >&2
  echo "  Generate at: vault.bitwarden.com → Settings → Security → Keys → API Key" >&2
  echo "  Then:" >&2
  echo "    export BW_CLIENTID='user.<uuid>'" >&2
  echo "    export BW_CLIENTSECRET='<secret>'" >&2
  echo "    devbox global run bitw-login" >&2
  exit 1
fi

# ── Sanity-check client_id format ──
if [[ ! "$BW_CLIENTID" =~ ^user\.[0-9a-f-]{36}$ ]]; then
  echo "${YELLOW}⚠${NC} BW_CLIENTID format looks unexpected: $BW_CLIENTID" >&2
  echo "  Expected: user.<uuid> (e.g. user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)" >&2
  echo "  Continuing anyway — format may have changed server-side." >&2
fi

# ── Login ──
echo "${CYAN}Logging in to Bitwarden via bitw (client_credentials grant)...${NC}"
if bitw login; then
  echo ""
  echo "${GREEN}${BOLD}✓ bitw logged in${NC}"
  echo ""
  echo "Next: ${CYAN}devbox global run secrets-refresh${NC} to populate the cache file,"
  echo "      or ${CYAN}devbox global run bitw status${NC} for token source / expiry / LastSync"
else
  echo ""
  echo "${RED}✗ bitw login failed.${NC}" >&2
  echo "  Check BW_CLIENTID and BW_CLIENTSECRET are correct." >&2
  echo "  Regenerate at: vault.bitwarden.com → Settings → Security → Keys → API Key" >&2
  exit 1
fi
