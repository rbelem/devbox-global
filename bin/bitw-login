#!/usr/bin/env bash
# bitw-login
# Login to Bitwarden via bitw. Routing handled by bitw login itself:
#   - BW_CLIENTID + BW_CLIENTSECRET set → client_credentials (silent)
#   - Neither set → interactive (prompts for server, email, password, TOTP)
#   - Exactly one set → bitw errors with actionable guidance
#
# As of Phase 2 (035ea4f), this script is a thin wrapper. The hard
# BW_CLIENTID/BW_CLIENTSECRET requirement that previously lived here
# was removed; bitw login now errors clearly with the same guidance
# when exactly one env var is set. The master password is stored in
# libsecret by bitw login (best-effort) when interactive, so subsequent
# `bitw get` calls work without re-prompting.
#
# For interactive password prompts, bitw uses a priority chain:
#   1. zenity (GTK dialog)
#   2. kdialog (KDE dialog)
#   3. SSH_ASKPASS (if set; useful for non-TTY / scripted environments)
#   4. terminal (/dev/tty)
#
# ── Usage ──
#   # API key login (machine-to-machine, no prompts):
#   export BW_CLIENTID='user.<uuid>'
#   export BW_CLIENTSECRET='<secret>'
#   devbox global run bitw-login
#
#   # Interactive login (password grant):
#   unset BW_CLIENTID BW_CLIENTSECRET
#   devbox global run bitw-login
#   # → bitw prompts for: server (cloud/self), email, master password, TOTP
#
# ── One-time setup for API key users ──
# Generate a BW Personal API Key:
#   1. Log in to vault.bitwarden.com
#   2. Settings → Security → Keys → API Key
#   3. Master password confirmation
#   4. Copy the two values:
#        client_id:     user.<uuid>  (format: user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
#        client_secret: one-time-shown string (save it — not shown again)
#
# self-heal on first `bitw cache`.
# `devbox-global/bitwarden-api-key` (Login type, .login.password = client_secret,
# custom field BW_CLIENTID = user.<uuid>) per ADR-0003, so new machines
# self-heal on first `bitw cache`.
#
# ── Status check (after Phase 7a) ──
#   devbox global run bitw status   # prints token source, expiry, LastSync
#
# ── References ──
# ADR-0003 — Bitwarden Personal API Key dual-storage pattern
# ADR-0004 — bw → bitw CLI parity migration
# ADR-0005 — Phase 7 token-broker architecture (forthcoming)
set -euo pipefail

# ── Colors ──
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'

# ── Preflight: bitw must be installed ──
if ! command -v bitw >/dev/null 2>&1; then
  echo "${RED}ERROR:${NC} bitw not found. Run: devbox global install" >&2
  exit 1
fi

# ── Sanity-check client_id format (only if BW_CLIENTID is set) ──
if [ -n "${BW_CLIENTID:-}" ]; then
  if [[ ! "$BW_CLIENTID" =~ ^user\.[0-9a-f-]{36}$ ]]; then
    echo "${YELLOW}⚠${NC} BW_CLIENTID format looks unexpected: $BW_CLIENTID" >&2
    echo "  Expected: user.<uuid> (e.g. user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)" >&2
    echo "  Continuing anyway — format may have changed server-side." >&2
  fi
fi

# ── Login ──
# bitw login handles path selection:
#   - both env vars → client_credentials (silent)
#   - exactly one env var → clear error
#   - neither → interactive (prompts for server, email, password, TOTP)
if [ -n "${BW_CLIENTID:-}" ] && [ -n "${BW_CLIENTSECRET:-}" ]; then
  echo "${CYAN}Logging in to Bitwarden via bitw (client_credentials grant)...${NC}"
else
  echo "${CYAN}Logging in to Bitwarden via bitw (interactive)...${NC}"
fi

if bitw login; then
  echo ""
  echo "${GREEN}${BOLD}✓ bitw logged in${NC}"
  echo ""
  echo "Next: ${CYAN}bitw cache${NC} to populate the cache file,"
  echo "      or ${CYAN}devbox global run bitw status${NC} for token source / expiry / LastSync"
else
  echo ""
  echo "${RED}✗ bitw login failed.${NC}" >&2
  echo "  Common causes:" >&2
  echo "    - For API key login: ensure BW_CLIENTID and BW_CLIENTSECRET are both set and correct." >&2
  echo "    - For interactive login: ensure you have a TTY (or set FORCE_STDIN_PROMPTS=true) and SSH_ASKPASS if non-interactive." >&2
  echo "  Regenerate API key at: vault.bitwarden.com → Settings → Security → Keys → API Key" >&2
  exit 1
fi