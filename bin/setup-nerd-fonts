#!/usr/bin/env bash
set -euo pipefail

# Keep the stable devbox profile path, never a resolved /nix/store path:
# the GC erases resolved paths and fontconfig then serves dead fonts.
NERDFONTS_DIR="$(devbox global path)/.devbox/nix/profile/default/share/fonts/truetype/NerdFonts"

if [ ! -d "$NERDFONTS_DIR" ]; then
  echo "Nerd Fonts not found in devbox global profile. Run: devbox global install" >&2
  exit 1
fi

mkdir -p "$HOME/.config/fontconfig/conf.d"
cat <<EOF > "$HOME/.config/fontconfig/conf.d/10-nerdfonts.conf"
<?xml version='1.0'?>
<!DOCTYPE fontconfig SYSTEM 'fonts.dtd'>
<fontconfig>
  <dir>$NERDFONTS_DIR</dir>
</fontconfig>
EOF
fc-cache -fv
