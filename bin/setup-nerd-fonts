#!/usr/bin/env bash
set -euo pipefail

PROFILE=$(readlink -f "$(devbox global path)/.devbox/nix/profile/default")
NERDFONTS_DIR=$PROFILE/share/fonts/truetype/NerdFonts

if [ ! -d "$NERDFONTS_DIR" ]; then
  echo "Nerd Fonts not found in devbox global profile. Run: devbox global install" >&2
  exit 1
fi

mkdir -p "$HOME/.config/fontconfig/conf.d"
cat <<EOF > "$HOME/.config/fontconfig/conf.d/10-nerdfonts.conf"
<?xml version='1.0'?>
<!DOCTYPE fontconfig SYSTEM 'fonts.dtd'>
<fontconfig>
  <dir>$NERDFONTS_DIR</dir>
</fontconfig>
EOF
fc-cache -fv
