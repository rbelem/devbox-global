#!/usr/bin/env bash
# devbox-global-vet-flakes
# Fast read-only vet over devbox.d/*/flake.nix (statix + parse check).
# To wire into pre-commit/CI when tooling exists:
#   repos: [{repo: local, hooks: [{id: vet-flakes, entry: bin/vet-flakes, language: script}]}]
#   (or run bin/vet-flakes as a CI job step; no network/build needed).
set -euo pipefail

SHOW_HELP=false
declare -a TARGETS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            SHOW_HELP=true
            shift
            ;;
        -*)
            echo "Unknown flag: $1"
            exit 1
            ;;
        *)
            TARGETS+=("$1")
            shift
            ;;
    esac
done

if $SHOW_HELP; then
    echo "Usage: $(basename "$0") [PKG...]"
    echo "Fast read-only vet over devbox.d/*/flake.nix files."
    echo ""
    echo "  PKG [...]    Vet specific packages by name (default: all)"
    echo "  -h, --help   Show this help"
    exit 0
fi

# NOTE: nixfmt is intentionally not wired: it is not installed here
# (no nixfmt binary; `nix fmt` needs a repo flake formatter, so we
# skip it rather than emit a false FAIL). If nixfmt appears on PATH
# later, add a `nixfmt --check` pass next to the statix pass below.
# NOTE: no `nix flake show/metadata` per flake — too slow and needs
# network; `nix-instantiate --parse` is a cheap offline syntax check.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

HAVE_STATIX=false
HAVE_PARSE=false
command -v statix >/dev/null 2>&1 && HAVE_STATIX=true
command -v nix-instantiate >/dev/null 2>&1 && HAVE_PARSE=true

mapfile -t FLAKES < <(
    if [[ ${#TARGETS[@]} -gt 0 ]]; then
        for t in "${TARGETS[@]}"; do
            f="$REPO_ROOT/devbox.d/$t/flake.nix"
            [[ -f "$f" ]] && echo "$f" || echo "MISSING:$t"
        done
    else
        printf '%s\n' "$REPO_ROOT"/devbox.d/*/flake.nix
    fi
)

pass=0
fail=0
warn=0
for f in "${FLAKES[@]}"; do
    rel="${f#$REPO_ROOT/}"
    if [[ "$f" == MISSING:* ]]; then
        echo "FAIL $rel (no such flake)"
        fail=$((fail + 1))
        continue
    fi
    reasons=()
    if $HAVE_STATIX; then
        if ! out=$(statix check "$f" 2>&1); then
            reasons+=("statix: $out")
        fi
    fi
    if $HAVE_PARSE; then
        if ! out=$(nix-instantiate --parse "$f" >/dev/null 2>&1); then
            out=$(nix-instantiate --parse "$f" 2>&1 | head -5 | tr '\n' ' ')
            reasons+=("parse: $out")
        fi
    fi
    if [[ ${#reasons[@]} -eq 0 ]]; then
        echo "PASS $rel"
        pass=$((pass + 1))
    else
        echo "FAIL $rel"
        for r in "${reasons[@]}"; do
            echo "  $r"
        done
        fail=$((fail + 1))
    fi
done

echo ""
# WARN-ONLY nixpkgs input consistency check (text-level, offline: no nix
# invocations). Divergent specs never fail the vet and never change the
# exit code — informational only.
# Text-level nixpkgs input extraction (offline: no nix invocations).
# Prints the first nixpkgs.url value in the file, or nothing.
# NOTE: no `| head -n 1` here — under `set -o pipefail` head closing
# early SIGPIPEs sed (exit 141) and aborts the script on multi-match
# files; sed's `q` stops cleanly instead.
nixpkgs_spec() {
    sed -n '/nixpkgs\.url *= *"/{s/.*nixpkgs\.url *= *"\([^"]*\)".*/\1/p;q;}' "$1"
}
declare -A _spec_files=()
declare -a _spec_order=()
for _f in "${FLAKES[@]}"; do
    [[ "$_f" == MISSING:* ]] && continue
    [[ -f "$_f" ]] || continue
    _spec=$(nixpkgs_spec "$_f")
    [[ -z "${_spec:-}" ]] && _spec="unspecified"
    _pkg=$(basename "$(dirname "$_f")")
    if [[ -z "${_spec_files[$_spec]+x}" ]]; then
        _spec_order+=("$_spec")
        _spec_files[$_spec]="$_pkg"
    else
        _spec_files[$_spec]="${_spec_files[$_spec]} $_pkg"
    fi
done
if [[ ${#_spec_order[@]} -gt 1 ]]; then
    warn=$((warn + 1))
    echo "WARN nixpkgs-inputs-diverge (${#_spec_order[@]} distinct specs)"
    for _spec in "${_spec_order[@]}"; do
        # shellcheck disable=SC2206
        _pkgs=( ${_spec_files[$_spec]} )
        _shown=""
        _i=0
        for _p in "${_pkgs[@]}"; do
            [[ $_i -ge 8 ]] && break
            _shown="${_shown:+$_shown }$_p"
            _i=$((_i + 1))
        done
        if [[ ${#_pkgs[@]} -gt 8 ]]; then
            _shown="$_shown …+$(( ${#_pkgs[@]} - 8 )) more"
        fi
        echo "WARN $_spec -> $_shown"
    done
    echo "WARN divergent nixpkgs revs mix libc generations (observed: GLIBC_2.43 skew broke chromium launch); pin together on bump — see wigolo-git flake pin comment"
    for _spec in "${_spec_order[@]}"; do
        if [[ "$_spec" == "github:NixOS/nixpkgs/nixpkgs-unstable" ]]; then
            # shellcheck disable=SC2206
            _odd=( ${_spec_files[$_spec]} )
            for _p in "${_odd[@]}"; do
                echo "WARN odd-one-out: devbox.d/$_p/flake.nix uses nixpkgs-unstable (likely typo for nixos-unstable)"
            done
        fi
    done
fi

echo "vet-flakes: $pass passed, $fail failed, $warn warned (statix=$HAVE_STATIX parse=$HAVE_PARSE)"
[[ $fail -eq 0 ]]
