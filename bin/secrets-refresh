#!/usr/bin/env bash
# secrets-refresh
# Fetch secrets from Bitwarden → $XDG_RUNTIME_DIR/devbox-secrets.sh (600).
# Uses bitw get (reads master password from system keyring internally).
# Run: devbox global run secrets-refresh
set -euo pipefail

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; NC=$'\033[0m'

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}"
if [ -z "$XDG_RUNTIME_DIR" ]; then
  echo "${RED}ERROR:${NC} \$XDG_RUNTIME_DIR is not set. Cannot write cache." >&2
  exit 1
fi

CACHE="$XDG_RUNTIME_DIR/devbox-secrets.sh"

# Validate bitw can reach the vault
bitw get devbox-global/github-token --field name >/dev/null 2>&1 || {
  echo "${RED}Cannot reach Bitwarden vault. Check your login status.${NC}" >&2
  exit 1
}

# name → env var
declare -A ITEMS=(
  ["devbox-global/github-token"]="GITHUB_TOKEN"
  ["devbox-global/brave-api-key"]="BRAVE_API_KEY"
  ["devbox-global/mistral-api-key"]="MISTRAL_API_KEY"
  ["devbox-global/firecrawl-api-key"]="FIRECRAWL_API_KEY"
  ["devbox-global/openai-api-key"]="OPENAI_API_KEY"
  ["devbox-global/opencode-auth-cookie"]="OPENCODE_GO_AUTH_COOKIE"
  ["devbox-global/opencode-workspace-id"]="OPENCODE_GO_WORKSPACE_ID"
  ["devbox-global/bitwarden-api-key"]="BW_CLIENTSECRET"
)

declare -A CUSTOM_FIELDS=(
  ["devbox-global/openai-api-key"]="OPENAI_BASE_URL,OPENAI_MODEL"
  ["devbox-global/bitwarden-api-key"]="BW_CLIENTID"
)

# ── Fetch all secrets → cache file ──
errors=0
tmp="$(mktemp)"
{
  echo "# Auto-generated by secrets-refresh. Do not edit."
  echo "# Regenerate: devbox global run secrets-refresh"
  echo "# Source: Bitwarden vault ($(date -u +%Y-%m-%dT%H:%M:%SZ))"
  echo ""
  for name in "${!ITEMS[@]}"; do
    var="${ITEMS[$name]}"
    out="$(bitw get "$name" --env-name "$var" 2>/dev/null)" || {
      printf '# %s: bitw get failed\n' "$var" >&2
      ((errors++)) || true
      continue
    }
    if [ -n "$out" ]; then
      printf '%s\n' "$out"
    else
      printf '# %s: not found or empty in vault\n' "$var" >&2
    fi
    if [ "${CUSTOM_FIELDS[$name]:-}" ]; then
      IFS=',' read -ra field_names <<< "${CUSTOM_FIELDS[$name]}"
      field_args=()
      for field_name in "${field_names[@]}"; do
        field_args+=(--field "$field_name")
      done
      raw="$(bitw get "$name" "${field_args[@]}" 2>/dev/null)" || {
        printf '# %s: bitw get fields failed\n' "$var" >&2
        ((errors++)) || true
        continue
      }
      i=0
      while IFS= read -r val; do
        if [ -n "$val" ]; then
          printf 'export %s=%q\n' "${field_names[$i]}" "$val"
        fi
        ((i++)) || true
      done <<< "$raw"
    fi
  done
  echo ""
  echo 'export GH_TOKEN=$GITHUB_TOKEN'
  echo 'export WIGOLO_GITHUB_TOKEN=$GITHUB_TOKEN'
} > "$tmp"

if [ "$errors" -gt 0 ]; then
  echo "${YELLOW}⚠ $errors item(s) failed. Cache may be incomplete.${NC}" >&2
fi

chmod 600 "$tmp"
mv "$tmp" "$CACHE"
echo "${GREEN}✓ Secrets cached to $CACHE${NC}"

# ── Mirror BW API key to libsecret (defense-in-depth fallback) ──
# Source the cache we just wrote so BW_CLIENTSECRET/BW_CLIENTID are in scope.
. "$CACHE" 2>/dev/null || true
if [ -n "${BW_CLIENTSECRET:-}" ] && command -v secret-tool >/dev/null 2>&1; then
  secret-tool store --label="Bitwarden API key" bitwarden api-key-secret "$BW_CLIENTSECRET" 2>/dev/null || true
  [ -n "${BW_CLIENTID:-}" ] && \
    secret-tool store --label="Bitwarden API key" bitwarden api-key-client-id "$BW_CLIENTID" 2>/dev/null || true
  echo "${GREEN}✓ BW API key mirrored to libsecret${NC}"
fi
