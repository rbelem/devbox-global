#!/usr/bin/env bash
# devbox-global-update-flake
# Lists devbox global packages, identifies flake packages,
# checks latest GitHub version, and optionally updates them.
#
# The version detection lives in bin/flake-detect.py: it reads the enabled
# flakes, parses each devbox.d/<flake>/flake.nix and asks GitHub for the
# newest version published in the release line the flake tracks. This script
# turns that answer into the table and owns the update machinery.
set -euo pipefail

# ── Argument parsing ──
# Positional args = packages to update (no -u flag needed, since
# devbox intercepts dash flags before passing to scripts).
# Use -u/--update for direct script invocation (bypassing devbox).
SHOW_HELP=false
ALL_FLAKES=false
declare -a UPDATE_TARGETS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--update)
            shift
            while [[ $# -gt 0 && ! "$1" == -* ]]; do
                UPDATE_TARGETS+=("$1")
                shift
            done
            ;;
        -a|--all)
            ALL_FLAKES=true
            shift
            ;;
        -h|--help)
            SHOW_HELP=true
            shift
            ;;
        -*)
            echo "Unknown flag: $1"
            exit 1
            ;;
        *)
            # Positional arg = package to update
            UPDATE_TARGETS+=("$1")
            shift
            ;;
    esac
done

if $SHOW_HELP; then
    echo "Usage: $(basename "$0") [PKG...]"
    echo "Check and optionally update devbox global flake packages."
    echo ""
    echo "  PKG [...]    Update specific packages by name"
    echo "  -a, --all    Update all packages with available updates"
    echo "  (no args)    Show version comparison table"
    echo "  -u PKG [...] Alternative to positional args (for direct use)"
    echo "  -h, --help   Show this help"
    exit 0
fi

# Colors (declared before preflight so error paths can use them under set -u)
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

# ── Preflight: gh, python3 and the detector must be there ──
# gh release list / gh api calls below use `2>/dev/null || true` to keep
# detection robust, but a missing gh auth causes ALL packages to show "unknown"
# silently. Fail fast with a clear message instead.
if ! command -v gh >/dev/null 2>&1; then
    echo "${RED}ERROR${NC}: gh is not installed." >&2
    echo "Install: ${BOLD}nix-env -iA nixpkgs.gh${NC} or your distro's package manager." >&2
    exit 1
fi
if ! gh auth status >/dev/null 2>&1; then
    echo "${RED}ERROR${NC}: gh is not authenticated." >&2
    echo "Run: ${BOLD}gh auth login${NC}" >&2
    exit 1
fi
# The detection runs in python3 (it ships with the devbox global profile).
if ! command -v python3 >/dev/null 2>&1; then
    echo "${RED}ERROR${NC}: python3 is not installed." >&2
    echo "Install: ${BOLD}nix-env -iA nixpkgs.python3${NC} or your distro's package manager." >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DETECTOR="$SCRIPT_DIR/flake-detect.py"
if [[ ! -f "$DETECTOR" ]]; then
    echo "${RED}ERROR${NC}: the version detector is missing: $DETECTOR" >&2
    exit 1
fi

DEVBOX_GLOBAL_PATH="$(devbox global path)"
DEVBOX_JSON="$DEVBOX_GLOBAL_PATH/devbox.json"
DEVBOX_D="$DEVBOX_GLOBAL_PATH/devbox.d"

# Fake hash placeholders. Every hash attribute gets its OWN fake, and all of
# them share this prefix: the build error names the fake it rejected, so the
# real hash goes back into the attribute that failed instead of into the
# first fake hash in the file - which may belong to a different attribute
# (a dependency's hash, another architecture's entry).
FAKE_PREFIX='sha256-AAAA'

# ── Detection ──
# The detector answers, for every enabled flake: the upstream repository, the
# release line, the installed version, the newest upstream version and the
# relation between the two. It prints one TSV line per flake.
if ! DETECT_TSV="$(python3 "$DETECTOR" --global-dir "$DEVBOX_GLOBAL_PATH")"; then
    echo "${RED}ERROR${NC}: the version detection failed (see the output above)." >&2
    exit 1
fi

declare -A DET_REPO DET_ORIGIN DET_KIND DET_PREFIX DET_MAJOR
declare -A DET_INSTALLED DET_INSTALLED_RAW DET_LATEST DET_RELATION DET_REASON
declare -A DET_UPSTREAM DET_FORK_SUFFIX DET_BRANCH DET_INPUT DET_VERSION_SOURCE
declare -a FLAKES=()

while IFS=$'\t' read -r name repo origin kind prefix major installed_raw installed latest relation reason upstream fork_suffix branch input version_source; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    FLAKES+=("$name")
    DET_REPO["$name"]="$repo"
    DET_ORIGIN["$name"]="$origin"
    DET_KIND["$name"]="$kind"
    DET_PREFIX["$name"]="$prefix"
    DET_MAJOR["$name"]="$major"
    DET_INSTALLED_RAW["$name"]="$installed_raw"
    DET_INSTALLED["$name"]="$installed"
    DET_LATEST["$name"]="$latest"
    DET_RELATION["$name"]="$relation"
    DET_REASON["$name"]="$reason"
    DET_UPSTREAM["$name"]="$upstream"
    DET_FORK_SUFFIX["$name"]="$fork_suffix"
    DET_BRANCH["$name"]="$branch"
    DET_INPUT["$name"]="$input"
    DET_VERSION_SOURCE["$name"]="$version_source"
done <<< "$DETECT_TSV"

# ── Parse installed versions from `devbox global list` ──
# Only the nixpkgs packages are shown here; the flake versions come from the
# detector.
declare -A INSTALLED
while IFS= read -r line; do
    line="${line#\* }"
    if [[ "$line" == path:* ]]; then
        name="${line#path:}"
        name="${name#devbox.d/}"
        INSTALLED["$name"]="flake"
    else
        pkg="${line%% -*}"
        ver="${line##* - }"
        ver="${ver## }"
        name="${pkg%@*}"
        INSTALLED["$name"]="$ver"
    fi
done < <(devbox global list 2>/dev/null)

# Flakes whose flake.lock the updater re-resolved this run. The global copy's
# lock is fresh but the repo copy's is still stale, so a reverse config-sync is
# required before committing. Reported at the end so it isn't forgotten.
declare -a LOCK_REFRESHED=()

# ── Version writing ──
# The block between the two markers is extracted by
# tests/update/version-spelling.sh, which checks the spellings without
# running a build.

# Escape a version so it can be used as a literal in a grep/sed pattern.
sed_escape() {
    printf '%s' "$1" | sed -e 's/[][\.*^$()+?{}|\/]/\\&/g'
}

# The spellings a version can have in a flake, and the new spelling of each.
# The same version is written two ways: bare ("0.16.0") and with the tag
# prefix of its release line ("v0.16.0", "dsh-v0.2.1-alpha.1"). A flake does
# not use the same spelling everywhere - graphify pins the version attribute
# as "0.9.91" and the input URL as "v0.9.91", steel-takeoff pins the
# attribute as "0.16.0" and the input URL as "v0.16.0" - so every spelling
# that occurs in the file is replaced by the same spelling of the new
# version.
#
# Fills OLD_SPELLINGS and NEW_SPELLINGS (parallel arrays).
version_spellings() {
    local name="$1" old_ver="$2" new_ver="$3"
    local prefix="${DET_PREFIX[$name]:-}"
    local suffix="${DET_FORK_SUFFIX[$name]:-}"
    # "-" is the empty marker of the detector, not a prefix or a suffix.
    [[ "$prefix" == "-" ]] && prefix=""
    [[ "$suffix" == "-" ]] && suffix=""

    OLD_SPELLINGS=("$old_ver")
    NEW_SPELLINGS=("${new_ver}${suffix}")
    if [[ -n "$prefix" && "$old_ver" != "$prefix"* ]]; then
        OLD_SPELLINGS+=("${prefix}${old_ver}")
        NEW_SPELLINGS+=("${prefix}${new_ver}${suffix}")
    fi
}

# Replace every spelling of the old version in the flake with the same
# spelling of the new version. The version lives in a `version = "..."`
# attribute and/or in the ref of a github input URL
# (`github:owner/repo/v1.2.3`); a flake may use either or both, and the two
# do not always use the same spelling.
# Echoes one line per replacement; returns 0 when something was written.
write_version() {
    local flake_nix="$1" name="$2" old_ver="$3" new_ver="$4"
    local index old_spelling new_spelling old_escaped
    local updated=false

    declare -a OLD_SPELLINGS=() NEW_SPELLINGS=()
    version_spellings "$name" "$old_ver" "$new_ver"

    for index in "${!OLD_SPELLINGS[@]}"; do
        old_spelling="${OLD_SPELLINGS[$index]}"
        new_spelling="${NEW_SPELLINGS[$index]}"
        old_escaped="$(sed_escape "$old_spelling")"

        if grep -qP "\\bversion\\s*=\\s*\"$old_escaped\"" "$flake_nix"; then
            sed -ri "s/(\\bversion\\s*=\\s*)\"$old_escaped\"/\\1\"$new_spelling\"/g" "$flake_nix"
            echo "    ✓ version field updated ($old_spelling → $new_spelling)"
            updated=true
        fi

        if grep -qF "/$old_spelling\"" "$flake_nix"; then
            sed -i "s|/$old_spelling\"|/$new_spelling\"|g" "$flake_nix"
            echo "    ✓ input URL ref updated ($old_spelling → $new_spelling)"
            updated=true
        fi

        # A source pinned by a literal tag (rev = "v1.2.3") moves with the
        # version: a source and a version that disagree build the old code
        # under the new name.
        if grep -qF "rev = \"$old_spelling\"" "$flake_nix"; then
            sed -i "s|rev = \"$old_spelling\"|rev = \"$new_spelling\"|g" "$flake_nix"
            echo "    ✓ source ref updated ($old_spelling → $new_spelling)"
            updated=true
        fi
    done
    $updated
}

# ── end version writing ──

# Replace every hash attribute's value with its own fake hash.
#
# The fakes differ from each other in one character and share the prefix, so
# the build error that rejects one of them names the attribute that failed
# ("specified: sha256-AAAAX..."), and the real hash can go back into exactly
# that attribute. With one shared fake the paste-back could only guess, and on
# a flake with several hash attributes it pasted the wrong value into the
# wrong one.
#
# The old value is kept in a "; # FIXME: was ..." comment on the same line,
# so a failed resolution can be rolled back by hand.
reset_hashes() {
    local flake_nix="$1" hash_attrs="$2"
    awk -v attrs="$hash_attrs" -v prefix="$FAKE_PREFIX" '
        BEGIN {
            alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            n = 0
        }
        {
            line = $0
            if (line ~ /^[ \t]*#/) { print line; next }
            pattern = "(^|[ \t])(" attrs ")[ \t]*=[ \t]*\"sha256-[A-Za-z0-9+/=]+\"|(\"[^\"]+\"[ \t]*=[ \t]*)\"sha256-[A-Za-z0-9+/=]+\""
            out = ""
            rest = line
            while (match(rest, pattern)) {
                # The inner match() below overwrites RSTART/RLENGTH, so keep
                # the position of the outer match.
                mpos = RSTART
                mlen = RLENGTH
                head = substr(rest, 1, mpos - 1)
                matched = substr(rest, mpos, mlen)
                vstart = match(matched, /"sha256-[A-Za-z0-9+\/=]+"/)
                vlen = RLENGTH
                value = substr(matched, vstart, vlen)
                fake = "\"" prefix substr(alphabet, (n % 64) + 1, 1) \
                       substr("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 1, 38) "=\""
                out = out head substr(matched, 1, vstart - 1) fake \
                      ";  # FIXME: was " value
                rest = substr(rest, mpos + mlen)
                n++
            }
            print out rest
        }
    ' "$flake_nix" > "$flake_nix.fake" && mv "$flake_nix.fake" "$flake_nix"
}

# ── Verify a candidate against the real release assets ──
# The detection already picks the release line the flake tracks (its tag
# prefix), so a candidate normally resolves. This guards the remaining case:
# a release that has no asset for this platform cannot be downloaded and the
# flake would not build.
# Echoes the failure reason (asset-404 | verify-error), or nothing when the
# candidate's asset URL resolves. Always succeeds.
verify_candidate_asset() {
    local name="$1" candidate="$2"
    local dir="${name%%#*}"
    local flake_nix="$DEVBOX_D/$dir/flake.nix"
    local repo="${DET_REPO[$name]:-}"

    [[ -n "$repo" && "$repo" != "unknown" ]] || return 0

    local url_template
    url_template="$(grep -oP 'https://github\.com/[^"]*\$\{version\}[^"]*' "$flake_nix" 2>/dev/null | grep 'releases/download/' | head -1 || true)"
    [[ -n "$url_template" ]] || return 0  # not a release-asset flake: nothing to verify

    # Candidate tags to try: the tag the flake's own URL template names is the
    # ground truth (whatever the detection guessed for the release line),
    # falling back to the detected prefix and then to a v-prefixed tag.
    local template_prefix=""
    if [[ "$url_template" == *"/releases/download/"* ]]; then
        template_prefix="${url_template#*/releases/download/}"
        template_prefix="${template_prefix%%\$\{version\}*}"
    fi
    local prefix="${DET_PREFIX[$name]:-}"
    local -a tags_to_try=()
    if [[ -n "$template_prefix" ]]; then
        tags_to_try=("${template_prefix}${candidate}")
    elif [[ -n "$prefix" && "$prefix" != "-" ]]; then
        tags_to_try=("${prefix}${candidate}")
    else
        tags_to_try=("v${candidate}" "${candidate}")
    fi

    local tag="" release_json=""
    for tag in "${tags_to_try[@]}"; do
        release_json="$(gh api "repos/$repo/releases/tags/$tag" 2>&1 || true)"
        echo "$release_json" | grep -q '"tag_name"' && break
        release_json=""
    done
    if [[ -z "$release_json" ]]; then
        # None of the candidate tags names a real release.
        release_json="$(gh api "repos/$repo/releases/tags/${tags_to_try[0]}" 2>&1 || true)"
        if echo "$release_json" | grep -qi 'not found\|404'; then
            echo "asset-404"
        else
            echo "verify-error"
        fi
        return 0
    fi

    # The asset filename the flake would fetch: template with the candidate
    # substituted, cut at the first remaining nix interpolation (e.g.
    # bsk-v0.3.3-${systemToTarget...}.tar.gz -> prefix bsk-v0.3.3-).
    local url_sub="${url_template//\$\{version\}/$candidate}"
    local asset_file="${url_sub##*/}"
    local asset_prefix="${asset_file%%\$*}"
    local asset_url
    asset_url="$(gh api "repos/$repo/releases/tags/$tag" --jq "[.assets[] | select(.name | startswith(\"$asset_prefix\")) | .browser_download_url][0] // empty" 2>/dev/null || true)"
    if [[ -z "$asset_url" ]]; then
        echo "asset-404"
        return 0
    fi

    local code
    code="$(curl -sIL -o /dev/null --max-time 20 -w '%{http_code}' "$asset_url" 2>/dev/null || true)"
    if [[ -z "$code" ]]; then
        echo "verify-error"
    elif [[ "$code" != 2* ]]; then
        echo "asset-404"
    fi
    return 0
}

# ── Update a single flake package ──
update_flake() {
    local name="$1" old_ver="$2" new_ver="$3"
    local dir="${name%%#*}"
    local flake_nix="$DEVBOX_D/$dir/flake.nix"
    local repo="${DET_ORIGIN[$name]:-}"

    [[ -f "$flake_nix" ]] || { echo "  File not found"; return 1; }
    [[ -z "$old_ver" || "$old_ver" == "flake" || "$old_ver" == "unknown" || "$old_ver" == "dynamic" ]] \
        && { echo "  Cannot determine installed version"; return 1; }

    # The version the flake should carry from now on, in every spelling it
    # uses today.
    [[ "$old_ver" == "$new_ver" ]] && { echo "  Already at latest: $old_ver"; return 0; }

    echo "  ${BOLD}${name}${NC}: $old_ver → $new_ver  (${repo})"

    # Two independent places a version can live, and a flake may use either or
    # both:
    #   (a) a `version = "..."` attribute
    #   (b) the ref of a github input URL — `github:owner/repo/v1.2.3`
    # URL-pinned flakes (e.g. hermes-agent) have NO `version =` attribute at
    # all: the URL ref *is* the version. Requiring (a) made those flakes
    # report "Could not find version = ... — skipping" and never update, even
    # though the table above correctly detected the new release. So track
    # whether *either* write landed and only bail if neither did.
    if ! write_version "$flake_nix" "$name" "$old_ver" "$new_ver"; then
        echo "  ! Could not find version \"$old_ver\" in flake.nix — neither a"
        echo "      version = attribute nor an input URL ref matched — skipping"
        return 1
    fi

    # 2b. Refresh the lockfile for the bumped input.
    #     Editing the URL only changes the input's *original* ref; flake.lock
    #     keeps pinning the OLD rev until it is re-resolved. Nix then builds a
    #     derivation named for the new version filled with the OLD source, so
    #     the store path claims 2026.8.31 while `hermes --version` answers
    #     2026.8.27. Always verify with the binary, never the store path.
    local input_name="${DET_INPUT[$name]:-}"
    if [[ -n "$input_name" && "$input_name" != "-" ]]; then
        local lock_output
        if lock_output=$(cd "$DEVBOX_D/$dir" && nix flake update "$input_name" 2>&1); then
            echo "    ✓ flake.lock re-resolved for input '$input_name'"
            # The lockfile in the *repo* copy is still stale after this —
            # pull it back with: devbox global run config-sync -- --reverse --sync
            LOCK_REFRESHED+=("$name")
        else
            echo "    ${YELLOW}!${NC} nix flake update '$input_name' failed:"
            echo "$lock_output" | grep -E '(error:|Error:)' | head -3 | sed 's/^/      /'
            echo "      flake.lock may still pin the old revision — refresh it manually"
            return 1
        fi
    fi

    # 3. Reset hashes to literal fake hashes (no pkgs dependency, works in any
    #    scope). Each attribute gets its own fake, so the build error says
    #    which one failed.
    #    Named attrs: hash, srcHash, cargoHash, npmDepsHash, pnpmDepsHash,
    #                 npmDistHash, nodeModulesHash, outputHash, vendorHash
    #    Quoted attrs: "platform" = "sha256-..." (agent-browser pattern)
    #    Comment lines are skipped: a comment that quotes an attribute must
    #    not be rewritten into a fake hash.
    local hash_attrs='hash|srcHash|cargoHash|npmDepsHash|pnpmDepsHash|npmDistHash|nodeModulesHash|outputHash|vendorHash'
    if grep -qE "(^|[[:space:]])($hash_attrs)[[:space:]]*=[[:space:]]*\"sha256-" "$flake_nix" 2>/dev/null \
        || grep -qE '"[^"]+"[[:space:]]*=[[:space:]]*"sha256-' "$flake_nix" 2>/dev/null; then
        reset_hashes "$flake_nix" "$hash_attrs"
        echo "    ✓ hashes reset to fakeHash"
    else
        echo "    - no hashes to reset"
    fi
}

# ── Auto-resolve hashes by building and capturing "got" hash ──
resolve_hashes() {
    local name="$1"
    local dir="${name%%#*}"
    local flake_dir="$DEVBOX_D/$dir"
    local flake_nix="$flake_dir/flake.nix"
    local max_attempts=10
    local result=1  # default: failure
    local attempt=0

    # Only if hashes were reset to fakeHash
    if grep -qF "$FAKE_PREFIX" "$flake_nix" 2>/dev/null; then
        echo ""
        echo "    Computing hashes (building with nix)..."

        for ((attempt=1; attempt<=max_attempts; attempt++)); do
            # Check if all fakeHash placeholders are resolved
            if ! grep -qF "$FAKE_PREFIX" "$flake_nix" 2>/dev/null; then
                echo "    ${GREEN}✓${NC} all hashes resolved"
                result=0
                break
            fi

            # Build the flake and capture output.
            # `timeout 600` guards against stalled substituters / wedged networks —
            # max_attempts bounds FAILED attempts but a hung build blocks forever otherwise.
            local build_output
            if build_output=$(cd "$flake_dir" && timeout 600 nix build --no-link ".#default" 2>&1); then
                echo "    ${GREEN}✓${NC} build succeeded"
                # The build only evaluates the host system, so the hash
                # entries of the other architectures can still be fake. Say
                # so: they break the build on those systems.
                if grep -qF "$FAKE_PREFIX" "$flake_nix" 2>/dev/null; then
                    local remaining
                    remaining="$(grep -cF "$FAKE_PREFIX" "$flake_nix" 2>/dev/null || echo 0)"
                    echo "    ${YELLOW}!${NC} $remaining hash entr$([[ $remaining -eq 1 ]] && echo y || echo ies) still fake —"
                    echo "      the build did not evaluate them (other architectures?)"
                fi
                result=0
                break
            fi

            # Extract "got" hash from error output.
            # NOTE: avoid `grep -oP '...\K...'` (PCRE lookbehind) — Alpine/musl/busybox
            # greps don't support -P. Use ERE with sed to strip the prefix.
            local got_hash
            got_hash=$(echo "$build_output" | grep -oE 'got:[[:space:]]+sha256-[a-zA-Z0-9+/=]+' | head -1 | sed -E 's/^got:[[:space:]]+//')

            if [[ -z "$got_hash" ]]; then
                echo "    ${YELLOW}!${NC} non-hash build error:"
                echo "$build_output" | grep -E '(error:|Error:)' | head -5 | sed 's/^/      /'
                break
            fi

            # The error names the fake it rejected: that is the attribute that
            # failed, so the real hash goes back into THAT attribute. Writing
            # it into the first fake hash in the file instead would put a
            # dependency's hash into the source attribute.
            local specified
            specified=$(echo "$build_output" | grep -oE 'specified:[[:space:]]*sha256-[a-zA-Z0-9+/=]+' | head -1 | sed -E 's/^specified:[[:space:]]*//')
            if [[ -n "$specified" ]]; then
                sed -i "s|$specified|$got_hash|" "$flake_nix"
            else
                # No named fake in the output: fall back to the first one.
                sed -i "0,/$FAKE_PREFIX/{s|$FAKE_PREFIX[a-zA-Z0-9+/=]*|$got_hash|}" "$flake_nix"
            fi
            # The trailing `; # FIXME: was "..."` audit comment (injected by the
            # reset step above) is stripped from the same line — it's only
            # meaningful during the resolution loop.
            sed -i -E -e "0,/${got_hash//\//\\/}/{s/;[[:space:]]*#[[:space:]]*FIXME:[[:space:]]*was[[:space:]]*\"sha256-[^\"]*\"//}" "$flake_nix"
            echo "    hash $attempt: $got_hash"
        done
    else
        result=0
    fi

    # Final cleanup: strip any FIXME residue left behind (e.g. from previous
    # bumps where one arch's hash could not be resolved on the host arch).
    # Idempotent — no-op on clean files.
    sed -i -E 's/;[[:space:]]*#[[:space:]]*FIXME:[[:space:]]*was[[:space:]]*"[^"]*"//g' "$flake_nix" 2>/dev/null || true

    if [[ $result -eq 1 && $attempt -ge $max_attempts ]]; then
        echo "    ${YELLOW}!${NC} max retries reached"
    fi

    return $result
}

# ── Detect flakes that exist in devbox.d/ but aren't enabled in devbox.json ──
# FLAKES (built above) only contains the enabled path:devbox.d/X entries of
# devbox.json - a commented-out entry is not enabled - so all loops iterate
# enabled flakes only. Surface un-enabled flake dirs here so they are visible
# rather than silently ignored.
if [[ -d "$DEVBOX_D" ]]; then
    declare -a SKIPPED_FLAKES=()
    while IFS= read -r dir_name; do
        [[ -z "$dir_name" ]] && continue
        enabled=false
        for fname in "${FLAKES[@]}"; do
            [[ "$dir_name" == "${fname%%#*}" ]] && { enabled=true; break; }
        done
        $enabled || SKIPPED_FLAKES+=("$dir_name")
    done < <(find "$DEVBOX_D" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null | sort)

    if [[ ${#SKIPPED_FLAKES[@]} -gt 0 ]]; then
        printf "${YELLOW}Note: %d flake(s) in devbox.d/ are not enabled in devbox.json (skipped):${NC}\n" "${#SKIPPED_FLAKES[@]}"
        printf '  - %s\n' "${SKIPPED_FLAKES[@]}"
        printf "\n"
    fi
fi

# ── Print results ──
printf "\n${BOLD}${CYAN}═══ Devbox Global Flake Packages ═══${NC}\n\n"
printf "${BOLD}%-15s %-25s %-15s %-15s %-8s${NC}\n" "PACKAGE" "SOURCE" "INSTALLED" "LATEST" "STATUS"
printf "%-15s %-25s %-15s %-15s %-8s\n" "───────" "──────" "─────────" "──────" "──────"

for name in "${FLAKES[@]}"; do
    source_display="${DET_REPO[$name]:-unknown}"
    installed="${DET_INSTALLED[$name]:-unknown}"
    latest="${DET_LATEST[$name]:-unknown}"
    relation="${DET_RELATION[$name]:-unknown}"
    reason="${DET_REASON[$name]:--}"

    case "$relation" in
        up-to-date) status="${GREEN}✓${NC}" ;;
        older)      status="${RED}↓${NC}" ;;
        ahead)      status="${YELLOW}↑${NC}" ;;
        *)          status="${YELLOW}??${NC}" ;;
    esac
    # The reason names the blocker: a sha-pinned source, an interpolated
    # version, a pre-release newest version, a branch-tracking build.
    [[ -n "$reason" && "$reason" != "-" ]] && status="$status ($reason)"

    latest_display="${latest#branch:}"

    printf "%-15s %-25s %-15s %-15s %b\n" "$name" "$source_display" "$installed" "$latest_display" "$status"
done

printf "\n${BOLD}${CYAN}═══ Nixpkgs Packages ═══${NC}\n\n"
printf "${BOLD}%-20s %-15s %-8s${NC}\n" "PACKAGE" "INSTALLED" "SOURCE"
printf "%-20s %-15s %-8s\n" "───────" "─────────" "──────"

for name in "${!INSTALLED[@]}"; do
    ver="${INSTALLED[$name]}"
    [[ "$ver" == "flake" ]] && continue
    is_flake=false
    for fname in "${FLAKES[@]}"; do
        [[ "$name" == "${fname%%#*}" ]] && { is_flake=true; break; }
    done
    $is_flake && continue
    printf "%-20s %-15s %s\n" "$name" "$ver" "nixpkgs"
done | sort

printf "\n"
printf "${GREEN}✓${NC} = up to date  ${RED}↓${NC} = older (update available)  ${YELLOW}↑${NC} = ahead of latest  ${YELLOW}??${NC} = unknown/unverified (reason in STATUS)\n"

# ── Update workflow ──
if [[ ${#UPDATE_TARGETS[@]} -gt 0 || $ALL_FLAKES == true ]]; then
    # Build list of upgradable packages. Only a flake whose newest upstream
    # version is strictly newer than the installed one is upgradable: a
    # sha-pinned source (?? sha-pinned) and an interpolated version
    # (?? dynamic-version) carry no "older" relation and are never touched.
    declare -a UPGRADABLE=()
    for name in "${FLAKES[@]}"; do
        [[ "${DET_RELATION[$name]:-}" == "older" ]] && UPGRADABLE+=("$name")
    done

    # Tell the user explicitly when --all / -u finds nothing — silent no-op is confusing.
    if [[ ${#UPGRADABLE[@]} -eq 0 ]]; then
        if $ALL_FLAKES; then
            echo ""
            echo "${GREEN}${BOLD}All flake packages are already at latest.${NC}"
        elif [[ ${#UPDATE_TARGETS[@]} -gt 0 ]]; then
            echo ""
            echo "${GREEN}${BOLD}No updates available for the requested packages.${NC}"
        fi
    fi

    # Validate targets against known flakes
    declare -a TARGETS=()
    if $ALL_FLAKES; then
        TARGETS=("${UPGRADABLE[@]}")
    fi
    if [[ ${#UPDATE_TARGETS[@]} -gt 0 ]]; then
        for target in "${UPDATE_TARGETS[@]}"; do
            found=false
            for name in "${UPGRADABLE[@]}"; do
                if [[ "$name" == "$target" ]]; then found=true; break; fi
            done
            if $found; then
                TARGETS+=("$target")
            else
                # Check if it's a known flake
                is_flake=false
                for name in "${FLAKES[@]}"; do
                    if [[ "$name" == "$target" ]]; then is_flake=true; break; fi
                done
                if ! $is_flake; then
                    echo "  Package '$target' is not a known flake package."
                elif [[ "${DET_RELATION[$target]:-}" != "older" ]]; then
                    installed="${DET_INSTALLED[$target]:-unknown}"
                    reason="${DET_REASON[$target]:--}"
                    if [[ "$reason" != "-" ]]; then
                        echo "  Package '$target' is at $installed ($reason) — skipping."
                    else
                        echo "  Package '$target' is already at $installed (no update needed)."
                    fi
                elif grep -qF "$FAKE_PREFIX" "$DEVBOX_D/${target%%#*}/flake.nix" 2>/dev/null; then
                    # Version matches but hashes not fully resolved — retry resolution
                    TARGETS+=("$target")
                else
                    echo "  Package '$target' is already at ${DET_INSTALLED[$target]:-unknown} (no update needed)."
                fi
            fi
        done
    fi

    if [[ ${#TARGETS[@]} -gt 0 ]]; then
        echo ""
        echo "${BOLD}${CYAN}Applying updates...${NC}"
        for name in "${TARGETS[@]}"; do
            echo ""
            installed="${DET_INSTALLED[$name]:-unknown}"
            latest="${DET_LATEST[$name]:-unknown}"
            # The candidate must resolve to a downloadable release asset before
            # the flake is rewritten: a missing asset means a broken build.
            reason="$(verify_candidate_asset "$name" "$latest")"
            if [[ -n "$reason" ]]; then
                echo "  ${BOLD}${name}${NC}: candidate $latest has no downloadable asset (${reason}) — skipping."
                continue
            fi
            update_flake "$name" "$installed" "$latest" || true
            resolve_hashes "$name" || echo "    ${YELLOW}!${NC} hash resolution incomplete (see above)"
        done
        echo ""
        echo "${BOLD}${GREEN}All updates applied.${NC}"

        # Refreshing a lockfile only touched the GLOBAL copy. The repo copy is
        # still pinning the old rev, so the next forward sync would clobber the
        # fix and the commit would ship a stale lock. Say so explicitly.
        if [[ ${#LOCK_REFRESHED[@]} -gt 0 ]]; then
            echo ""
            printf "${YELLOW}! flake.lock re-resolved in the global copy for: %s${NC}\n" "${LOCK_REFRESHED[*]}"
            echo "  Pull it back into the repo before committing:"
            echo "    devbox global run config-sync -- --reverse --sync"
        fi
        echo ""
        echo "→ Running post-install hooks..."
        "$DEVBOX_GLOBAL_PATH/bin/post-install"
    fi
fi

printf "\n"
